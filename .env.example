# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored — never commit it.

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Dummy key for the Exercise 3 research MCP server (it only checks the key is set).
# ex3_research.agent reads it from here. Claude Code does not read .env: for the
# server in .mcp.json, export RESEARCH_API_KEY in the shell that starts claude.
RESEARCH_API_KEY=dev-research-key

# Model used by the lab scripts (Haiku is cheap and good enough here)
MODEL=claude-haiku-5-5
